[Unit]
Description=Weaselway host preparation for the GNOME session
Documentation=https://github.com/weaselway/weaselway

# Loads dxgdrm, takes /tmp/.X11-unix back, and mounts the WSLg shared-memory
# share. The last fails the unit when the weaselway system distro is not the one
# in use; the session still starts and shows mutter's error frame.

# wslg.service is generated by WSL at every boot and bind mounts
# /mnt/wslg/.X11-unix read-only over /tmp/.X11-unix, creating the mountpoint as
# a root-owned 0755 directory on the way. We undo both, so we have to run after
# it -- otherwise it lands on top of us and the session cannot open its X
# socket. Ordering on a unit that does not exist is not an error, so this stays
# harmless on a distro where WSL generates no such thing.
After=local-fs.target wslg.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/weaselway/prep-session.sh

[Install]
WantedBy=multi-user.target
